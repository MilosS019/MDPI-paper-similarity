# Copy to .env and adjust. Every setting can also be set as an environment variable.
# No secrets are needed: all services run locally and the embedding model is open source.

# Postgres (asyncpg driver). The docker compose stack exposes Postgres on localhost:5432.
PULSE_DATABASE_URL=postgresql+asyncpg://pulse:pulse@localhost:5432/pulse

# Qdrant HTTP endpoint and collection name.
PULSE_QDRANT_URL=http://localhost:6333
PULSE_QDRANT_COLLECTION=arxiv_papers

# Embedding model (fastembed / ONNX). Changing it requires `pulse reindex`.
PULSE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where fastembed caches model files. Leave empty for the library default.
PULSE_EMBEDDING_CACHE_DIR=

# arXiv API client.
PULSE_ARXIV_BASE_URL=https://export.arxiv.org/api/query
PULSE_ARXIV_PAGE_SIZE=50
PULSE_ARXIV_REQUEST_DELAY_SECONDS=3.0
PULSE_ARXIV_TIMEOUT_SECONDS=30.0
PULSE_ARXIV_MAX_RETRIES=4

# Raw landing zone for ingested arXiv records (Parquet files).
PULSE_RAW_DATA_DIR=data/raw/arxiv

# Submissions and similarity search.
PULSE_MAX_SUBMISSION_CHARS=100000
PULSE_CHUNK_MAX_TOKENS=512
PULSE_CHUNK_OVERLAP_TOKENS=64

# Logging: "json" for machines, "console" for humans.
PULSE_LOG_LEVEL=INFO
PULSE_LOG_FORMAT=console
